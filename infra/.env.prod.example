# Copied to infra/.env.prod by `bash scripts/keys.sh infra/.env.prod infra/.env.prod.example`, which fills in the
# empty secrets below. infra/.env.prod is git-ignored. Used only by infra/docker-compose.prod.yml.

# Secrets. POSTGRES_PASSWORD is hex so it fits in the connection string unescaped; the others are base64 of 32 bytes.
POSTGRES_PASSWORD=
TOTP_ENC_KEY=
PASSWORD_PEPPER=

# The host name the browser uses. It becomes APP_ORIGIN, ALLOWED_ORIGINS, WEBAUTHN_RP_ID and Caddy's certificate.
# Passkeys stay bound to it for good. A phone needs a name it can resolve, never an IP (see the README).
WALLET_HOST=localhost
# Host port Caddy publishes, part of the origin. Rootless Podman cannot bind 443.
WALLET_HTTPS_PORT=8443
# 127.0.0.1 keeps the stack on this machine; 0.0.0.0 opens it to the LAN.
WALLET_BIND=127.0.0.1
