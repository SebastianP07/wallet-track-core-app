# Copied to .env by `make keys`, which also fills in the empty secrets below.

# HTTP server
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

# Local Postgres (infra/docker-compose.yml). 5433 avoids clashing with a host Postgres on 5432.
POSTGRES_DB=wallet_track
POSTGRES_USER=wallet_track
POSTGRES_PASSWORD=wallet_track_local
POSTGRES_PORT=5433
# Optional. When unset, the Makefile builds it from the values above, on 127.0.0.1.
# DATABASE_URL=postgres://user:password@127.0.0.1:5433/dbname?sslmode=disable

# Secrets: base64-encoded 32 random bytes. Generate with `make keys`.
TOTP_ENC_KEY=
PASSWORD_PEPPER=
# Only while rotating: the old key, with the new one in TOTP_ENC_KEY. See `cmd/admin rotate-totp-key`.
# TOTP_ENC_KEY_PREVIOUS=

# Comma-separated CIDRs of proxies whose X-Forwarded-For is believed. Empty ignores the header.
TRUSTED_PROXIES=
# Comma-separated exact origins accepted on mutating requests. A request with another Origin gets a 403.
ALLOWED_ORIGINS=http://localhost:3000
# Local development only: drops Secure and the __Host- prefix from cookies, for browsers on plain HTTP.
INSECURE_DEV_COOKIES=false
